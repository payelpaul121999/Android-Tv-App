<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NewModuleActivity">
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="start"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#494646">
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:nextFocusRight="@id/tabRecyclerview"
            android:background="@drawable/ic_circle"
            android:layout_gravity="center"
            android:layout_marginLeft="14dp"
            android:src="@drawable/baseline_person"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabRecyclerview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:itemCount="4"
            android:layout_gravity="center"
            android:layout_marginLeft="10sp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/tab_card_item"
            android:orientation="horizontal"
            />
        <ImageView
            android:id="@+id/searchImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:nextFocusLeft="@id/tabRecyclerview"
            android:background="@drawable/btn_selector"
            android:layout_gravity="center"
            android:layout_marginLeft="14dp"
            android:src="@drawable/ic_search"/>

    </LinearLayout>
    <FrameLayout
        android:id="@+id/containerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topHeader"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>